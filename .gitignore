# Operating System specific
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Video processing extracted frame dumps (preserve directory via .gitkeep)
frames/*.jpg
frames/*.jpeg
frames/*.png
!frames/.gitkeep

# Generated runtime video outputs (preserve reference calibration assets)
output/*.mp4
output/*.avi
!output/reference_calibration/**

# IDE files
